# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MySQL
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/hostel_db"

# Generate a unique value of at least 32 characters for every environment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional SMTP configuration for password-reset email.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
